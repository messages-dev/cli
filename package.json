{
  "name": "@messages-dev/cli",
  "version": "0.2.2",
  "description": "Official CLI for messages.dev — send iMessages, manage lines, listen for events.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "messages-dev": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir dist",
    "build:binaries": "bun run scripts/build-binaries.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@messages-dev/sdk": "^0.2.1",
    "convex": "^1.33.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.7.0"
  }
}
